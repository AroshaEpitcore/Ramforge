# ----------------------------------------------------------------------------
# FrameForge — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Validated at build/runtime by src/lib/env.ts (@t3-oss/env-nextjs).
# ----------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# Public base URL of the app (used for absolute URLs, SEO, Stripe redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Prisma + PostgreSQL, hosted on Neon) -------------------------
# Runtime: use Neon's POOLED connection string. Local: a local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ramforge?schema=public
# Used by `prisma migrate` only. Local: same as DATABASE_URL.
# On Neon: the DIRECT (non-pooler) connection string.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ramforge?schema=public

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-me-with-a-long-random-string
# Optional in most setups; set behind a proxy or on a custom domain.
# AUTH_URL=http://localhost:3000

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-publishable-key

# --- Email (transactional) --------------------------------------------------
EMAIL_FROM=no-reply@frameforge.test
# RESEND_API_KEY=replace-with-your-resend-api-key

# --- Video hosting provider -------------------------------------------------
# Paid lessons stream from Mux; free videos use YouTube embeds (no hosting cost).
# One of: mock | mux | cloudflare | bunny. Keep `mock` until Mux keys are set.
VIDEO_PROVIDER=mock
# VIDEO_SIGNING_KEY=replace-me

# --- Mux (paid-lesson streaming) --------------------------------------------
# Dashboard → Settings → API Access Tokens (needs Mux Video read/write).
MUX_TOKEN_ID=replace-with-mux-token-id
MUX_TOKEN_SECRET=replace-with-mux-token-secret
# Signing key for signed playback (Settings → Signing Keys). MUX_SIGNING_KEY is
# the base64-encoded private key.
MUX_SIGNING_KEY_ID=replace-with-mux-signing-key-id
MUX_SIGNING_KEY=replace-with-mux-signing-key-base64
# Verify incoming Mux webhooks (Settings → Webhooks → signing secret).
MUX_WEBHOOK_SECRET=replace-with-mux-webhook-secret
